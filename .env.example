# L'alias AZURE_MAPS_ENDPOINT est également accepté.
AZURE_MAPS_URI=https://atlas.microsoft.com
AZURE_MAPS_SUBSCRIPTION_KEY=

# Authentification locale minimale activée par défaut (fail closed).
# Choix possibles : password, entra ou none (développement local uniquement).
AUTH_MODE=password
AUTH_USERNAME=collaborateur
AUTH_PASSWORD=

# Compte administrateur distinct en mode password.
ADMIN_USERNAME=administrateur
ADMIN_PASSWORD=

# Comptes temporaires de recette avant Entra ID. Liste JSON uniquement dans .env
# ou les secrets de l'hébergeur ; ne jamais versionner les vrais mots de passe.
# Exemple : [{"username":"test-atc","password":"mot-de-passe","display_name":"Test ATC","role":"atc","atc_code":"31-02-004"}]
LOCAL_TEST_ACCOUNTS_JSON=[]

# En mode Entra, les droits viennent exclusivement des App Roles du jeton.
# ENTRA_TENANT_ID verrouille explicitement le tenant attendu.
ENTRA_TENANT_ID=
ENTRA_ROLE_ATC=D-FR-APP-OPTIROUTE-ATC
ENTRA_ROLE_RAG=D-FR-APP-OPTIROUTE-RAG
ENTRA_ROLE_DR=D-FR-APP-OPTIROUTE-DR
ENTRA_ROLE_ADMIN=D-FR-APP-OPTIROUTE-ADMIN

GEOCODE_CACHE_PATH=.cache/geocoding.sqlite3

# Geocodeur gratuit officiel IGN / Base Adresse Nationale, pour les adresses francaises.
# La limite publique est 50 appels/IP/seconde ; l'application respecte 40 par defaut.
IGN_GEOCODING_ENDPOINT=https://data.geopf.fr/geocodage/search
IGN_GEOCODING_MAX_REQUESTS_PER_SECOND=40
# Repli Azure Maps seulement si IGN ne trouve pas l'adresse (active par defaut).
GEOCODING_AZURE_FALLBACK=true

# Développement local : sqlite. Azure Container Apps : azure_blob avec Managed Identity.
APP_STORAGE_BACKEND=sqlite
APP_STORAGE_PATH=.cache/opti_route.sqlite3
# AZURE_STORAGE_ACCOUNT_URL=https://nomducompte.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=opti-route-private
# Connexion locale/Azurite uniquement. Ne pas utiliser de connection string en production.
# AZURE_STORAGE_CONNECTION_STRING=
AZURE_MAPS_TIMEOUT_SECONDS=30

# pydeck est fiable sans authentification dans le navigateur.
# Utiliser azure seulement après avoir autorisé l'origine Streamlit dans le CORS Azure Maps.
MAP_RENDERER=pydeck
