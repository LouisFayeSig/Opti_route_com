[app]
AUTH_MODE = "password"
AUTH_USERNAME = "collaborateur"
AUTH_PASSWORD = "remplacer-par-un-mot-de-passe-long-et-unique"
ADMIN_USERNAME = "administrateur"
ADMIN_PASSWORD = "remplacer-par-un-autre-mot-de-passe-long-et-unique"
# Utilisé avec AUTH_MODE = "entra". Les valeurs doivent correspondre aux App Roles Entra.
ENTRA_TENANT_ID = "identifiant-tenant"
ENTRA_ROLE_ATC = "OptiRoute.ATC"
ENTRA_ROLE_DIRECTOR = "OptiRoute.Director"
ENTRA_ROLE_ADMIN = "OptiRoute.Admin"
AZURE_MAPS_URI = "https://atlas.microsoft.com"
AZURE_MAPS_SUBSCRIPTION_KEY = "remplacer-par-la-cle-azure-maps"
MAP_RENDERER = "pydeck"
APP_STORAGE_PATH = ".cache/opti_route.sqlite3"
# En production Azure, préférer les variables d'environnement suivantes avec Managed Identity :
# APP_STORAGE_BACKEND = "azure_blob"
# AZURE_STORAGE_ACCOUNT_URL = "https://nomducompte.blob.core.windows.net"
# AZURE_STORAGE_CONTAINER = "opti-route-private"

# Pour Entra ID, remplacer AUTH_MODE par "entra" ci-dessus et décommenter :
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "remplacer-par-une-longue-valeur-aleatoire"
#
# [auth.microsoft]
# client_id = "identifiant-application-entra"
# client_secret = "secret-client-entra"
# server_metadata_url = "https://login.microsoftonline.com/identifiant-tenant/v2.0/.well-known/openid-configuration"
